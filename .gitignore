# Виртуальное окружение и кэши
.venv/
__pycache__/
*.pyc

# Секреты (токены и т.п.) — НИКОГДА не коммитим
.secrets/
*.pem

# Данные (чаты ChatGPT — приватные данные, не пушим в GitHub)
data/
logs/
*.log

# Выборка личных сообщений — только на сервере
agent_profile/samples_user_messages.md

# Состояние драйверов (содержит id чатов, локально)
agent_jo/state_*.json

# Реестр папок проектов ChatGPT (личное, локально)
agent_jo/projects_registry.json

# Артефакты из чатов (приватные данные — только на сервере, не в git)
agent_profile/knowledge/
agent_profile/skills/
agent_profile/specs/
agent_profile/snippets/
agent_profile/BACKLOG.md
data/

# Локальные клоны проектов (работаем внутри их собственных репозиториев)
projects/

# Резервные копии правок (локальные, не в git)
agent_jo/.bak_*/

# Кэш JS-бандлов arena.ai (~10 МБ, пересобирается: scan_api.py scan --download)
arena_agent/.jscache/

# Скилл arena.ai версионируем, хотя остальные артефакты agent_profile приватные
!agent_profile/skills/
agent_profile/skills/*
!agent_profile/skills/skill-arena-ai.md
