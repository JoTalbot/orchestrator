[Unit]
Description=Jo ChatGPT driver (game): автономная работа над проектом в ChatGPT
After=network.target docker.service

[Service]
User=ubuntu
WorkingDirectory=/opt/orchestrator
ExecStart=/opt/orchestrator/.venv/bin/python -u agent_jo/jo_driver.py --project game --repo-path /opt/orchestrator/projects/game --cycle-delay 60
Restart=always
RestartSec=60
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
